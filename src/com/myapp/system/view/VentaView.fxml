<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" styleClass="panel-venta" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.system.controller.VentaController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <Label text="Cliente" />
      <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Selecciona un cliente" />
      <Label text="Producto" />
      <ComboBox fx:id="cmbProducto" maxWidth="Infinity" promptText="Selecciona un producto" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Cantidad" />
            <TextField fx:id="txtCantidad" prefWidth="80.0" />
            <Button mnemonicParsing="false" onAction="#onGuardar" styleClass="boton" text="Guardar venta" />
         </children>
      </HBox>
      <TableView fx:id="tblVentas" prefHeight="260.0">
         <columns>
            <TableColumn fx:id="colVenta" prefWidth="50.0" text="Venta" />
            <TableColumn fx:id="colFecha" prefWidth="80.0" text="Fecha" />
            <TableColumn fx:id="colCliente" prefWidth="120.0" text="Cliente" />
            <TableColumn fx:id="colProducto" prefWidth="120.0" text="Producto" />
            <TableColumn fx:id="colCantidad" prefWidth="70.0" text="Cantidad" />
            <TableColumn fx:id="colTotal" prefWidth="70.0" text="Total" />
         </columns>
      </TableView>
   </children>
</VBox>