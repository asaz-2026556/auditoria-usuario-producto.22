<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="900.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.system.controller.MainMenuController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="encabezado">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Label styleClass="titulo" text="MyApp" />
            <Label styleClass="etiqueta" text="Usuario:" />
            <Label fx:id="lblUsuario" styleClass="etiqueta" text="usuario" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="170.0" spacing="10.0" styleClass="menu-lateral">
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
         </padding>
         <children>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onInicio" styleClass="boton" text="Inicio" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onPerfil" styleClass="boton" text="Perfil" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onConfiguracion" styleClass="boton" text="Configuración" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onVentas" styleClass="boton" text="Ventas" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCerrarSesion" styleClass="boton" text="Cerrar Sesión" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contenedorCentral" styleClass="centro">
         <children>
            <Label fx:id="lblContenido" styleClass="texto-centro" text="Contenido" />
         </children>
      </StackPane>
   </center>
</BorderPane>