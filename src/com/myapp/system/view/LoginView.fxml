<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="380.0" spacing="12.0" styleClass="raiz" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.system.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="Iniciar Sesión" />
      <Label styleClass="etiqueta" text="Usuario" />
      <TextField fx:id="txtUsuario" styleClass="campo" />
      <Label styleClass="etiqueta" text="Contraseña" />
      <PasswordField fx:id="pwdContrasena" onAction="#onIngresar" styleClass="campo" />
      <Button defaultButton="true" mnemonicParsing="false" onAction="#onIngresar" styleClass="boton" text="Ingresar" />
      <Hyperlink onAction="#onCrearCuenta" styleClass="enlace" text="Crear Cuenta" />
   </children>
</VBox>
